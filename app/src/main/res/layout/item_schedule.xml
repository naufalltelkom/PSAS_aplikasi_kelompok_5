<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Badge Hari Bulat Sesuai Mockup Layar 4 -->
    <TextView
        android:id="@+id/tvDayBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_avatar"
        android:gravity="center"
        android:text="Mon"
        android:textColor="@color/telkom_red"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- CardView Jadwal Pelajaran -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSchedule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSubject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mata Pelajaran"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Badge Momentum Oranye -->
                <TextView
                    android:id="@+id/tvBadgeMomentum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/accent_momentum"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="MOMENTUM"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="07:40 - 11:40"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRoomAndTeacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ruang • Guru"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>