<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- KOLOM KIRI: TITIK BULAT STATUS & GARIS VERTIKAL TIMELINE -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Titik Bulat Indikator -->
        <View
            android:id="@+id/viewTimelineDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_fab_center" />

        <!-- Garis Vertikal Timeline Penghubung Antar Jam -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#CBD5E1" />
    </LinearLayout>

    <!-- KOLOM KANAN: KARTU PELAJARAN LENGKAP -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTimelineLesson"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="14dp"
        android:layout_weight="1"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimelineSubject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pemrograman Berorientasi Objek"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Badge Status: SEDANG BERLANGSUNG / SELESAI / MOMENTUM -->
                <TextView
                    android:id="@+id/tvTimelineStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_official"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="SEDANG BERLANGSUNG"
                    android:textColor="@color/telkom_red"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTimelineTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⏱️ 07:40 - 11:40 WIB"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTimelineTeacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Guru: Pak Thoriq, S.Kom"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Badge Ruangan Merah Kecil -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_header_portal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp">

                <TextView
                    android:id="@+id/tvTimelineRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RUANG A 2.5"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>