<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Latar Belakang Merah Telkom 70% dengan Lengkungan Sudut Bawah -->
    <item>
        <shape>
            <solid android:color="#B3B91C1C" />
            <corners
                android:bottomLeftRadius="32dp"
                android:bottomRightRadius="32dp" />
        </shape>
    </item>

    <!-- Pola Garis Motif Batik Elegan dan Halus -->
    <item>
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="45">
            <shape>
                <stroke
                    android:width="1.5dp"
                    android:color="#26FFFFFF" />
            </shape>
        </rotate>
    </item>
    <item>
        <rotate
            android:fromDegrees="-45"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="-45">
            <shape>
                <stroke
                    android:width="1.5dp"
                    android:color="#26FFFFFF" />
            </shape>
        </rotate>
    </item>
</layer-list>